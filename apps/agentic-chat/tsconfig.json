{
  "files": [],
  "include": ["./next-env.d.ts", "/dist/types/**/*.ts", "./dist/types/**/*.ts"],
  "exclude": ["node_modules"],
  "esModuleInterop": true,
  "jsx": "preserve",
  "allowJs": true,
  "forceConsistentCasingInFileNames": true,
  "references": [
    {
      "path": "../../utils"
    },
    {
      "path": "../../types"
    },
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ],
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "preserve"
  }
}
