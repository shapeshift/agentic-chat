{
  "name": "@shapeshiftoss/agentic-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsup",
    "build:tsc": "tsup && tsc --emitDeclarationOnly",
    "dev": "bun --env-file=../../.env.local --watch src/server.ts",
    "start": "bun dist/server.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.41",
    "@safe-global/protocol-kit": "^6.1.2",
    "@ai-sdk/openai-compatible": "^1.0.28",
    "@ai-sdk/provider": "^2.0.0",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.95.2",
    "ai": "^5.0.76",
    "axios": "^1.11.0",
    "expr-eval": "^2.0.2",
    "hono": "^4.10.2",
    "zod": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "tsup": "^8.5.0"
  }
}
