{
  "name": "@shapeshiftoss/agentic",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "clean": "yarn workspaces foreach --all --parallel run clean && rm -rf node_modules",
    "build": "yarn workspaces foreach --all --include 'packages/*' --parallel run build",
    "dev": "yarn dev:packages && npx concurrently \"nx run shapeshift-agentic-server:dev\" \"nx serve agentic-chat\"",
    "dev:apps": "npx concurrently \"yarn workspace @shapeshiftoss/agentic-server dev\" \"@shapeshiftoss/agentic-chat dev\"",
    "dev:packages": "yarn workspaces foreach --all --include 'packages/*' --parallel run dev",
    "lint": "yarn eslint --cache '*/**/*.{ts,tsx}'",
    "type-check": "yarn workspaces foreach --all --parallel run type-check"
  },
  "private": true,
  "dependencies": {
    "@shapeshiftoss/caip": "workspace:^",
    "@shapeshiftoss/types": "workspace:^",
    "@shapeshiftoss/utils": "workspace:^",
    "bignumber.js": "^9.1.2",
    "viem": "^2.7.9",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.23",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.0",
    "autoprefixer": "10.4.13",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "postcss": "8.4.38",
    "prettier": "^2.6.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "yarn@4.9.2"
}
