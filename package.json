{
  "name": "@shapeshiftoss/agentic",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.1.42"
  },
  "scripts": {
    "clean": "rm -rf node_modules packages/*/dist apps/*/dist",
    "build": "tsc --build && bun run --filter './apps/*' build",
    "build:chat": "tsc --build && bun --filter @shapeshiftoss/agentic-chat build",
    "build:server": "tsc --build && bun --filter @shapeshiftoss/agentic-server build",
    "dev": "bun run --filter './apps/*' dev",
    "dev:backend": "bun --filter @shapeshiftoss/agentic-server dev",
    "dev:frontend": "bun --filter @shapeshiftoss/agentic-chat dev",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --build",
    "update-assets": "bun scripts/updateAssetData.ts"
  },
  "dependencies": {
    "@shapeshiftoss/agentic-server": "workspace:^",
    "@shapeshiftoss/caip": "workspace:^",
    "@shapeshiftoss/types": "workspace:^",
    "@shapeshiftoss/utils": "workspace:^",
    "bignumber.js": "^9.3.0",
    "viem": "^2.31.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/eslint-plugin-jsx-a11y": "^6.10.0",
    "@types/node": "^24.0.1",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^18.0.1",
    "prettier": "^3.5.3",
    "tsx": "^4.20.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.1.42"
}
