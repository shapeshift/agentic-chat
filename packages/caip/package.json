{
  "name": "@shapeshiftoss/caip",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rm -rf dist && yarn run -T tsc --build",
    "dev": "yarn run -T tsc --build --watch --preserveWatchOutput",
    "type-check": "yarn run -T tsc --noEmit"
  },
  "dependencies": {
    "lodash": "^4.17.21"
  }
}
