{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "yarn install && yarn workspaces foreach --all --include \"packages/*\" --parallel run build && yarn workspace @shapeshiftoss/agentic-server build",
    "watchPatterns": [
      "apps/agentic-server/**",
      "packages/caip/**",
      "packages/utils/**",
      "packages/types/**",
      "railway.json",
      "package.json",
      "bun.lockb",
      "yarn.lock",
      ".yarnrc.yml",
      "tsconfig.json"
    ]
  },
  "deploy": {
    "startCommand": "cd apps/agentic-server/.mastra/output && bun index.mjs",
    "restartPolicyType": "ON_FAILURE"
  }
}