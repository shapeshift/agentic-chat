{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "yarn install && yarn workspaces foreach --all --include \"packages/*\" --parallel run build && yarn workspace @shapeshiftoss/agentic-server build",
    "watchPatterns": [
      "apps/agentic-server/**",
      "packages/caip/**",
      "packages/utils/**",
      "packages/types/**",
      "railway.json",
      "package.json",
      "yarn.lock",
      ".yarnrc.yml",
      "tsconfig.json"
    ]
  },
  "deploy": {
    "startCommand": "node apps/agentic-server/.mastra/output/index.mjs",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100
  }
}
