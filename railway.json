{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun install && bun build:server",
    "watchPatterns": [
      "apps/agentic-server/**",
      "packages/caip/**",
      "packages/utils/**",
      "packages/types/**",
      "railway.json",
      "package.json",
      "bun.lockb",
      "tsconfig.json"
    ]
  },
  "deploy": {
    "startCommand": "bun apps/agentic-server/dist/server.js",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100
  }
}
