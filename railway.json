{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "yarn workspaces foreach --all --include \"packages/*\" --parallel run build && yarn workspace @shapeshiftoss/agentic-server build",
    "watchPatterns": [
      "apps/agentic-server/**",
      "packages/utils/**",
      "packages/types/**",
      "railway.json",
      "package.json"
    ]
  },
  "deploy": {
    "startCommand": "cd apps/agentic-server && mastra start",
    "restartPolicyType": "ON_FAILURE"
  }
}