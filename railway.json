{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun install && bun run --filter='packages/*' build && bun run --filter='@shapeshiftoss/agentic-server' build",
    "watchPatterns": [
      "apps/agentic-server/**",
      "packages/utils/**",
      "packages/types/**",
      "railway.json",
      "package.json",
      "bun.lockb",
      "tsconfig.json"
    ]
  },
  "deploy": {
    "startCommand": "cd apps/agentic-server/.mastra/output && bun run --bun index.mjs",
    "restartPolicyType": "ON_FAILURE"
  }
}